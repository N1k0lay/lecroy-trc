{
  "name": "lecroy-trc",
  "version": "0.2.0",
  "private": true,
  "description": "Read Teledyne LeCroy TRC headers and waveform samples in Node.js",
  "license": "MIT",
  "keywords": [
    "lecroy",
    "trc",
    "oscilloscope",
    "waveform"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "build": "tsc && npm run build:browser",
    "build:browser": "tsc --module ES2022 --moduleResolution Bundler --declaration false --outDir dist/browser",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "prepack": "npm run build",
    "test:upstream": "npm run build && node scripts/check-upstream.cjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
